{
  "name": "nz-election-evidence-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public read-only Evidence Explorer for the NZ Election Evidence project. Static shell; contains no evidence data.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && node scripts/postbuild.ts",
    "build:pages": "VITE_BASE_PATH=/nz-election-evidence/ npm run build",
    "preview:pages": "node scripts/pages-preview.ts",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:pages": "playwright test --config playwright.pages.config.ts",
    "e2e:journey": "playwright test --config playwright.journey.config.ts",
    "types:generate": "node scripts/db-types.ts write",
    "types:check": "node scripts/db-types.ts check",
    "check:bundle": "node scripts/check-bundle.ts",
    "check:bundle:pages": "VITE_BASE_PATH=/nz-election-evidence/ node scripts/check-bundle.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@supabase/postgrest-js": "2.116.0",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-table": "9.2.4",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
