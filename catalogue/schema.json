{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thecolab-ai/nz-election-evidence/catalogue/schema.json",
  "title": "NZ Election Evidence source catalogue",
  "type": "array",
  "minItems": 24,
  "maxItems": 24,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "product_id",
      "title",
      "publisher",
      "domain",
      "source_url",
      "snapshot_at_utc",
      "record_count",
      "evidence_forms",
      "observed_start_utc",
      "observed_end_utc",
      "coverage_window",
      "release_mode",
      "rights_status",
      "known_limitations"
    ],
    "properties": {
      "product_id": {
        "type": "string",
        "pattern": "^P[0-9]{2}$"
      },
      "title": {
        "type": "string"
      },
      "publisher": {
        "type": "string"
      },
      "domain": {
        "type": "string"
      },
      "source_url": {
        "type": "string",
        "pattern": "^https://"
      },
      "snapshot_at_utc": {
        "type": "string"
      },
      "record_count": {
        "type": "integer",
        "minimum": 0
      },
      "evidence_forms": {
        "type": "array"
      },
      "observed_start_utc": {
        "type": "string"
      },
      "observed_end_utc": {
        "type": "string"
      },
      "coverage_window": {
        "type": "string"
      },
      "release_mode": {
        "const": "metadata-and-links-only"
      },
      "rights_status": {
        "const": "pending-publisher-review"
      },
      "known_limitations": {
        "type": "string"
      }
    }
  }
}
